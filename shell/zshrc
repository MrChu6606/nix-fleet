# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt extendedglob nomatch notify
setopt interactivecomments
unsetopt autocd beep
bindkey -v
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/nic/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

# enable pure
autoload -U promptinit; promptinit
autoload -U prompt pure

# activate pure
prompt pure

# Source external aliases if the file exists
if [ -f "$HOME/.zsh_aliases" ]; then
    source "$HOME/.zsh_aliases"
fi

# Helper function to check for active Nix / devenv environments
nix_shell_status() {
  if [ -n "$DEVENV_STATE" ]; then
    echo "%F{cyan}☕ devenv%f "
  elif [ -n "$IN_NIX_SHELL" ]; then
    echo "%F{blue}❄️ nix-shell%f "
  fi
}

# Enable prompt expansion
setopt PROMPT_SUBST

# Inject the function output into your prompt
PROMPT='$(nix_shell_status)'"$PROMPT"
